# syntax=docker/dockerfile:1
#
# nginx + php-fpm image (Alpine variant, LEGACY PHP 7.4)
#
# Same runtime layout as Dockerfile.alpine.template, but built on the last
# serversideup/php release that still ships PHP 7.4 (7.4-fpm-nginx-alpine,
# Alpine 3.16). That branch is EOL upstream: no security updates for PHP or
# the OS, extensions are compiled from source that install-php-extensions
# resolves to the newest versions still compatible with PHP 7.4.
#
# Differences from the main template:
#   - PHP 7.4 has no opcache JIT: PHP_OPCACHE_JIT / _JIT_BUFFER_SIZE are not
#     set (the serversideup ini template still carries the directives, PHP
#     ignores unknown ini keys).
#   - drush 8.4.x is the branch that runs on PHP 7.4 (drush 11+ needs 8.x).
#   - The base image predates the s6 user-bundles.d layout; the entrypoint
#     scripts already probe both locations.
#
# Base: serversideup/php (official PHP images, s6-overlay, install-php-extensions).
ARG PHP_VERSION
ARG UPSTREAM_VERSION

FROM serversideup/php:${UPSTREAM_VERSION}

ARG PHP_VERSION
ARG DRUSH_VERSION=8.4.12

# serversideup images run as www-data by default; we need root for sshd,
# cron, logrotate and the entrypoint.d config rewrites. php-fpm children
# still run as www-data/nginx (PHP_FPM_CHILD_PROCESS_* below).
USER root

ENV TIMEZONE=Asia/Shanghai \
    PHP_DATE_TIMEZONE=Asia/Shanghai \
    PHP_MEMORY_LIMIT=1024M \
    PHP_MAX_EXECUTION_TIME=180 \
    PHP_UPLOAD_MAX_FILE_SIZE=2G \
    PHP_POST_MAX_SIZE=2G \
    PHP_ERROR_LOG=/www/logs/php/error.log \
    PHP_LOG_LEVEL=error \
    PHP_OPCACHE_ENABLE=1 \
    PHP_OPCACHE_VALIDATE_TIMESTAMPS=1 \
    PHP_FPM_PROCESS_MANAGER=dynamic \
    PHP_FPM_MAX_CHILDREN=40 \
    PHP_FPM_START_SERVERS=4 \
    PHP_FPM_MIN_SPARE_SERVERS=2 \
    PHP_FPM_MAX_SPARE_SERVERS=8 \
    PHP_FPM_MAX_REQUESTS=0 \
    PHP_FPM_CHILD_PROCESS_USER=nginx \
    PHP_FPM_CHILD_PROCESS_GROUP=www-data \
    NGINX_ACCESS_LOG=/www/logs/nginx/access.log \
    NGINX_ERROR_LOG=/www/logs/nginx/error.log \
    NGINX_CLIENT_MAX_BODY_SIZE=2G \
    NGINX_HTTP_PORT=80 \
    NGINX_WORKER_PROCESSES=auto \
    DRUPAL_FILES_PERM_FIXED=FALSE \
    DRUSH_SQL_EXTRA="--skip-ssl" \
    CRON_DRUPAL_CRON="0 1 * * * drush -r /var/www/html/docroot/ cron" \
    LOGROTATE_RETAIN_DAYS=60 \
    LOGROTATE_COMPRESSION_TYPE=ZSTD \
    HTTP_HEADER_X_CONTENT_SECURITY_POLICY="default-src 'self' data: 'unsafe-inline' 'unsafe-eval' *.google.com *.baidu.com unpkg.com *.gstatic.com *.googleapis.com *.jsdelivr.net *.cloudflare.com d3js.org *.cookielaw.org *.youtube.com youtu.be *.youtu.be *.googleusercontent.com *.bootstrapcdn.com *.googletagmanager.com;" \
    USER_NAME=dsf \
    SHOW_WELCOME_MESSAGE=false \
    PATH=/var/www/html/vendor/bin:/var/www/html/bin:$PATH

# Optional Alpine mirror for unreliable networks (e.g. mirrors.aliyun.com)
ARG ALPINE_MIRROR=""
RUN if [ -n "$ALPINE_MIRROR" ]; then \
        sed -i "s|dl-cdn.alpinelinux.org|${ALPINE_MIRROR}|g" /etc/apk/repositories; \
    fi

# Alpine 3.16 package names are stable; a few packages (openssh, sudo, shadow)
# are not part of the serversideup base image and are installed here.
RUN for i in 1 2 3; do \
        apk add --no-cache \
            bash \
            ca-certificates \
            coreutils \
            curl \
            findutils \
            busybox-extras \
            git \
            iputils \
            logrotate \
            mariadb-client \
            mariadb-connector-c \
            nano \
            netcat-openbsd \
            openssh \
            openssh-sftp-server \
            patch \
            postgresql-client \
            rsync \
            shadow \
            sshpass \
            sudo \
            tzdata \
            wget \
            zip \
            zstd && break || { echo "apk add failed, retry $i/3"; sleep 10; }; \
    done && \
    rm -rf /var/cache/apk/*

## PHP extensions missing from the base image
## (zip/redis/pdo_pgsql/sodium/opcache are already provided by serversideup)
## install-php-extensions resolves the newest release compatible with PHP 7.4
## (e.g. msgpack 2.x, apcu 5.1.x) for each extension.
RUN for i in 1 2 3; do \
        install-php-extensions \
            igbinary \
            msgpack \
            memcached \
            imagick \
            ldap \
            yaml \
            bz2 \
            apcu \
            bcmath \
            exif \
            gd \
            imap \
            intl \
            mysqli \
            pgsql && break || { echo "install-php-extensions failed, retry $i/3"; sleep 10; }; \
    done && \
    ## Fail loudly if any extension did not actually get enabled
    ## (install-php-extensions can exit 0 even when a download failed)
    for ext in igbinary msgpack memcached imagick ldap yaml bz2 \
               apcu bcmath exif gd imap intl mysqli pgsql; do \
        php -m | grep -qix "$ext" || { echo "ERROR: PHP extension '$ext' missing after install"; exit 1; }; \
    done

## drush 8.x — the last branch that runs on PHP 7.4 (drush 11+/12+ require
## PHP 8.1+). Not needed on 8.3+, where projects pull drush via composer.
RUN if [ "$(printf '%s\n' "8.3" "${PHP_VERSION}" | sort -V | head -n1)" != "8.3" ]; then \
        curl -fsSL -o /usr/local/bin/drush "https://github.com/drush-ops/drush/releases/download/${DRUSH_VERSION}/drush.phar" && \
        chmod +x /usr/local/bin/drush && \
        drush core-status; \
    fi

RUN mkdir -p /etc/ssh/sshd_config.d && \
    ## sshd: our drop-in must win (sshd uses first-match-wins)
    grep -q '^Include /etc/ssh/sshd_config.d' /etc/ssh/sshd_config || \
        sed -i '1i Include /etc/ssh/sshd_config.d/*.conf' /etc/ssh/sshd_config && \
    mkdir -p /www/logs/nginx /www/logs/php

## Run nginx workers as nginx(80):www-data(82), matching the nfrastack-era
## identity so ownership of host-mounted logs/sites stays consistent.
## In this base nginx is uid 100/gid 101 and uid 80 is free, so a plain
## usermod is sufficient. The upstream template has no `user` directive, so
## nginx would otherwise fall back to its compile-time default (nginx:nginx).
RUN usermod -u 80 -g www-data nginx && \
    sed -i '1i user nginx www-data;' /etc/nginx/nginx.conf.template

ADD install /

RUN chmod +x /etc/entrypoint.d/*.sh \
        /etc/s6-overlay/s6-rc.d/cron/run \
        /etc/s6-overlay/s6-rc.d/sshd/run \
        /usr/local/sbin/start-*

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
    CMD curl -f http://localhost/user/login || exit 1

WORKDIR /var/www/html
EXPOSE 80 2222
